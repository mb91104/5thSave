# Copy to backend/.env and adjust for your machine.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/5thsave
# Required. Use a long random value; tokens signed with a different secret
# are rejected with 401s.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: comma-separated browser origins allowed to call the API.
# Leave unset for same-origin deployments (the default on Vercel).
# CORS_ORIGIN=https://your-app.vercel.app

# Optional: set to true only if your Postgres provider uses a self-signed cert.
# DATABASE_SSL=false
# Optional: connection pool size per serverless instance.
# PG_POOL_MAX=5
