import React, { useState, useEffect } from 'react';
import axios from 'axios';
import { 
  PieChart, Pie, Cell, ResponsiveContainer, 
  Tooltip, Legend, BarChart, Bar, XAxis, YAxis 
} from 'recharts';

const API_BASE = 'http://localhost:3000';

function App() {
  const [token, setToken] = useState(localStorage.getItem('token'));
  const [user, setUser] = useState(null);
  const [authMode, setAuthMode] = useState('login');
  const [authForm, setAuthForm] = useState({ email: '', password: '', username: '' });
  const [goalForm, setGoalForm] = useState({ amount_limit: '', start_date: '', end_date: '' });
  const [goals, setGoals] = useState([]);
  const [rewards, setRewards] = useState([]);
  const [products, setProducts] = useState([]);
  const [circles, setCircles] = useState([]);
  const [leaderboard, setLeaderboard] = useState([]);
  const [circleForm, setCircleForm] = useState({ circle_name: '', invite_token: '' });
  const [activeGoalId, setActiveGoalId] = useState(null);
  const [currentPage, setCurrentPage] = useState('dashboard'); // dashboard, shop, social
  const [cart, setCart] = useState([]);
  const [receipt, setReceipt] = useState(null);

  useEffect(() => {
    if (token) {
      fetchGoals();
      fetchRewards();
      fetchProducts();
      fetchCircles();
      fetchCart();
    }
  }, [token]);

  const handleAuth = async (e) => {
    e.preventDefault();
    const endpoint = authMode === 'login' ? '/auth/login' : '/auth/register';
    try {
      const res = await axios.post(`${API_BASE}${endpoint}`, authForm);
      if (authMode === 'login') {
        setToken(res.data.token);
        localStorage.setItem('token', res.data.token);
        setUser(res.data.user);
      } else {
        alert('Registered! Please login.');
        setAuthMode('login');
      }
    } catch (err) { alert(err.response?.data?.error || 'Auth failed'); }
  };

  const fetchGoals = async () => {
    try {
      const res = await axios.get(`${API_BASE}/goals`, { headers: { Authorization: `Bearer ${token}` } });
      setGoals(res.data);
    } catch (err) { console.error(err); }
  };

  const fetchRewards = async () => {
    try {
      const res = await axios.get(`${API_BASE}/rewards`, { headers: { Authorization: `Bearer ${token}` } });
      setRewards(res.data);
    } catch (err) { console.error(err); }
  };

  const fetchProducts = async () => {
    try {
      const res = await axios.get(`${API_BASE}/products`);
      setProducts(res.data);
    } catch (err) { console.error(err); }
  };

  const fetchCircles = async () => {
    try {
      const res = await axios.get(`${API_BASE}/circles`, { headers: { Authorization: `Bearer ${token}` } });
      setCircles(res.data);
    } catch (err) { console.error(err); }
  };

  const fetchCart = async () => {
    try {
      const res = await axios.get(`${API_BASE}/cart`, { headers: { Authorization: `Bearer ${token}` } });
      setCart(res.data);
    } catch (err) { console.error(err); }
  };

  const fetchLeaderboard = async (circleId) => {
    try {
      const res = await axios.get(`${API_BASE}/leaderboard/${circleId}`, { headers: { Authorization: `Bearer ${token}` } });
      setLeaderboard(res.data);
    } catch (err) { console.error(err); }
  };

  const resetGoals = async () => {
    if (!window.confirm('Are you sure you want to clear all your goals?')) return;
    try {
      await axios.delete(`${API_BASE}/goals`, { headers: { Authorization: `Bearer ${token}` } });
      fetchGoals();
      alert('Goals reset!');
    } catch (err) { alert(err.response?.data?.error || 'Error resetting goals'); }
  };

  const createGoal = async (e) => {
    e.preventDefault();
    try {
      await axios.post(`${API_BASE}/goals`, goalForm, { headers: { Authorization: `Bearer ${token}` } });
      fetchGoals();
    } catch (err) { alert(err.response?.data?.error || 'Error'); }
  };

  const endGoal = async (goalId) => {
    try {
      await axios.post(`${API_BASE}/goals/${goalId}/end`, { }, { headers: { Authorization: `Bearer ${token}` } });
      alert('Goal ended!');
      fetchGoals();
    } catch (err) { alert(err.response?.data?.error || 'Error'); }
  };

  const addToCart = async (productId) => {
    try {
      await axios.post(`${API_BASE}/cart`, { productId, quantity: 1 }, { headers: { Authorization: `Bearer ${token}` } });
      fetchCart();
      alert('Added to cart!');
    } catch (err) { alert(err.response?.data?.error || 'Error'); }
  };

  const removeFromCart = async (itemId) => {
    try {
      await axios.delete(`${API_BASE}/cart/${itemId}`, { headers: { Authorization: `Bearer ${token}` } });
      fetchCart();
    } catch (err) { alert(err.response?.data?.error || 'Error'); }
  };

  const checkout = async () => {
    if (!activeGoalId) return alert('Please select a goal for this session');
    try {
      const res = await axios.post(`${API_BASE}/shop/checkout`, { goalId: activeGoalId }, { headers: { Authorization: `Bearer ${token}` } });
      setReceipt(res.data);
      setCart([]);
      fetchGoals();
      fetchRewards();
      alert('Checkout successful! Time has progressed.');
    } catch (err) { alert(err.response?.data?.error || 'Checkout failed'); }
  };

  const createCircle = async (e) => {
    e.preventDefault();
    try {
      await axios.post(`${API_BASE}/circles`, { circle_name: circleForm.circle_name }, { headers: { Authorization: `Bearer ${token}` } });
      fetchCircles();
      setCircleForm({ ...circleForm, circle_name: '' });
    } catch (err) { alert(err.response?.data?.error || 'Error'); }
  };

  const joinCircleInvite = async (e) => {
    e.preventDefault();
    try {
      await axios.post(`${API_BASE}/circles/join-invite`, { token: circleForm.invite_token }, { headers: { Authorization: `Bearer ${token}` } });
      fetchCircles();
      setCircleForm({ ...circleForm, invite_token: '' });
      alert('Joined circle successfully!');
    } catch (err) { alert(err.response?.data?.error || 'Error'); }
  };

  const generateInvite = async (circleId) => {
    try {
      const res = await axios.post(`${API_BASE}/circles/invite`, { circle_id: circleId }, { headers: { Authorization: `Bearer ${token}` } });
      alert(`Invite Token: ${res.data.invite_token}`);
    } catch (err) { alert(err.response?.data?.error || 'Error'); }
  };

  if (!token) {
    return (
      <div className="auth-container">
        <div className="card auth-card">
          <h1>5thSave</h1>
          <p style={{ color: 'var(--text-muted)', marginBottom: '2rem' }}>Start saving smarter today</p>
          <form onSubmit={handleAuth} className="form-group">
            {authMode === 'register' && <input className="input-field" placeholder="Username" onChange={e => setAuthForm({...authForm, username: e.target.value})} />}
            <input className="input-field" placeholder="Email" onChange={e => setAuthForm({...authForm, email: e.target.value})} />
            <input className="input-field" type="password" placeholder="Password" onChange={e => setAuthForm({...authForm, password: e.target.value})} />
            <button type="submit" className="btn-primary">{authMode === 'login' ? 'Login' : 'Register'}</button>
            <button 
              type="button" 
              style={{ background: 'none', border: 'none', color: 'var(--primary)', cursor: 'pointer', marginTop: '1rem' }} 
              onClick={() => setAuthMode(authMode === 'login' ? 'register' : 'login')}
            >
              Switch to {authMode === 'login' ? 'Register' : 'Login'}
            </button>
          </form>
        </div>
      </div>
    );
  }

  return (
    <div className="app-container">
      <nav className="nav-bar">
        <strong style={{ fontSize: '1.5rem', marginRight: '2rem', color: 'var(--primary)' }}>5thSave</strong>
        <button className={`nav-btn ${currentPage === 'dashboard' ? 'active' : ''}`} onClick={() => setCurrentPage('dashboard')}>Dashboard</button>
        <button className={`nav-btn ${currentPage === 'shop' ? 'active' : ''}`} onClick={() => setCurrentPage('shop')}>Shopping</button>
        <button className={`nav-btn ${currentPage === 'social' ? 'active' : ''}`} onClick={() => setCurrentPage('social')}>Social</button>
        <button className="nav-btn logout-btn" onClick={() => { localStorage.removeItem('token'); setToken(null); }}>Logout</button>
      </nav>

      {currentPage === 'dashboard' && (
        <div className="grid-layout dashboard-grid">
          <section className="card">
            <h3>Set New Savings Goal</h3>
            <form onSubmit={createGoal} className="form-group">
              <input className="input-field" type="number" placeholder="Limit (₹)" onChange={e => setGoalForm({...goalForm, amount_limit: e.target.value})} />
              <input className="input-field" type="date" onChange={e => setGoalForm({...goalForm, start_date: e.target.value})} />
              <input className="input-field" type="date" onChange={e => setGoalForm({...goalForm, end_date: e.target.value})} />
              <button type="submit" className="btn-primary">Create Goal</button>
            </form>
            <div style={{ marginTop: '2rem' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '1rem' }}>
                <h4 style={{ margin: 0 }}>Your Active Goals</h4>
                <button onClick={resetGoals} style={{ fontSize: '11px', color: 'var(--danger)', background: 'none', border: 'none', cursor: 'pointer' }}>Reset All</button>
              </div>
              <div style={{ display: 'flex', flexDirection: 'column' }}>
                {goals.map(g => (
                  <div key={g.id} className="goal-item">
                    <div>
                      <strong>Goal #{g.id}</strong>: Limit ₹{g.amount_limit} 
                      <span className={`badge ${g.status === 'active' ? 'badge-active' : 'badge-ended'}`} style={{ marginLeft: '10px' }}>{g.status}</span>
                    </div>
                    {g.status === 'active' && (
                      <button onClick={() => endGoal(g.id)} className="nav-btn" style={{ fontSize: '12px', border: '1px solid var(--border)' }}>End Goal</button>
                    )}
                  </div>
                ))}
                {goals.length === 0 && <p style={{ color: 'var(--text-muted)' }}>No goals set yet.</p>}
              </div>
            </div>
          </section>

          <section className="card">
            <h3>📊 Budget Progress</h3>
            {goals.length > 0 ? (
              <div style={{ height: '300px' }}>
                <ResponsiveContainer width="100%" height="100%">
                  <PieChart>
                    <Pie 
                      data={[
                        { name: 'Spent', value: goals[0].amount_limit || 0 }, 
                        { name: 'Remaining', value: Math.max(0, goals[0].amount_limit - (goals[0].amount_limit || 0)) }
                      ]} 
                      cx="50%" cy="50%" 
                      outerRadius={80} 
                      fill="#8884d8" 
                      dataKey="value" 
                      label
                    >
                      <Cell fill="#ef4444" />
                      <Cell fill="#22c55e" />
                    </Pie>
                    <Tooltip />
                    <Legend />
                  </PieChart>
                </ResponsiveContainer>
              </div>
            ) : <p style={{ color: 'var(--text-muted)' }}>No goals set to visualize.</p>}
            <div style={{ marginTop: '2rem' }}>
               <h4 style={{ margin: '0 0 1rem 0' }}>🎁 Rewards Earned</h4>
               <div style={{ display: 'flex', gap: '10px', flexWrap: 'wrap' }}>
                {rewards.map(r => (
                  <div key={r.id} className="card" style={{ padding: '10px', background: '#f0fff0', borderColor: '#4caf50', fontSize: '0.9rem' }}>
                    <strong style={{ color: '#166534' }}>{r.checkpoint_percentage}%!</strong><br/>{r.reward_item}
                  </div>
                ))}
                {rewards.length === 0 && <p style={{ color: 'var(--text-muted)' }}>No rewards yet.</p>}
               </div>
            </div>
          </section>
        </div>
      )}

      {currentPage === 'shop' && (
        <div className="grid-layout shop-grid">
          <div className="card">
            <h3>🛒 Shopping Simulation</h3>
            <p style={{ color: 'var(--text-muted)', marginBottom: '1rem' }}>Select a goal to apply the spending to.</p>
            <select 
              onChange={e => setActiveGoalId(e.target.value)} 
              className="input-field"
              style={{ width: '100%', marginBottom: '2rem' }}
            >
              <option value="">-- Select Goal --</option>
              {goals.map(g => <option key={g.id} value={g.id}>Goal #{g.id} (Limit ₹{g.amount_limit})</option>)}
            </select>
            <div className="products-grid">
              {products.map(p => (
                <div key={p.id} className="card product-card">
                  <strong>{p.name}</strong><br/>
                  <span style={{ fontSize: '1.2rem', fontWeight: 'bold', display: 'block', margin: '0.5rem 0' }}>₹{p.price}</span>
                  <button 
                    onClick={() => addToCart(p.id)}
                    className="btn-primary"
                    style={{ width: '100%', fontSize: '0.9rem' }}
                  >
                    Add to Cart
                  </button>
                </div>
              ))}
            </div>
          </div>

          <div className="card" style={{ background: 'var(--background)' }}>
            <h3>🛒 Your Cart</h3>
            {cart.length > 0 ? (
              <div style={{ display: 'flex', flexDirection: 'column' }}>
                {cart.map(item => (
                  <div key={item.id} className="cart-item">
                    <span>{item.name} x{item.quantity} (₹{item.price * item.quantity})</span>
                    <button onClick={() => removeFromCart(item.id)} style={{ color: 'var(--danger)', background: 'none', border: 'none', cursor: 'pointer', fontWeight: 'bold' }}>X</button>
                  </div>
                ))}
                <div style={{ marginTop: '1.5rem', fontWeight: 'bold', textAlign: 'right', fontSize: '1.1rem' }}>
                  Total: ₹{cart.reduce((sum, item) => sum + (item.price * item.quantity), 0)}
                </div>
                <button 
                  onClick={checkout} 
                  className="btn-primary"
                  style={{ width: '100%', marginTop: '1rem' }}
                >
                  Checkout
                </button>
              </div>
            ) : <p style={{ color: 'var(--text-muted)' }}>Cart is empty.</p>}
            
            {receipt && (
              <div className="receipt-box">
                <h4 style={{ margin: '0 0 1rem 0', textAlign: 'center' }}>🧾 Receipt</h4>
                <div style={{ fontSize: '0.9rem' }}>
                  {receipt.receipt.map((item, i) => (
                    <div key={i} className="cart-item">
                      <span>{item.name} x{item.quantity}</span>
                      <span>₹{item.price * item.quantity}</span>
                    </div>
                  ))}
                  <hr style={{ border: 'none', borderTop: '1px solid var(--border)', margin: '1rem 0' }}/>
                  <div className="cart-item" style={{ fontWeight: 'bold', fontSize: '1rem' }}>
                    <span>Total</span>
                    <span>₹{receipt.totalAmount}</span>
                  </div>
                </div>
                <button 
                  onClick={() => setReceipt(null)} 
                  className="nav-btn"
                  style={{ width: '100%', marginTop: '1rem', textAlign: 'center', border: '1px solid var(--border)' }}
                >
                  Close Receipt
                </button>
              </div>
            )}
          </div>
        </div>
      )}

      {currentPage === 'social' && (
        <div className="grid-layout social-grid">
          <section className="card">
            <h3>👥 Social & Circles</h3>
            <form onSubmit={createCircle} className="form-group" style={{ flexDirection: 'row', gap: '10px' }}>
              <input 
                className="input-field"
                style={{ flex: 1 }}
                placeholder="New Circle Name" 
                value={circleForm.circle_name} 
                onChange={e => setCircleForm({...circleForm, circle_name: e.target.value})} 
              />
              <button type="submit" className="btn-primary">Create</button>
            </form>
            <form onSubmit={joinCircleInvite} className="form-group" style={{ flexDirection: 'row', gap: '10px', marginBottom: '2rem' }}>
              <input 
                className="input-field"
                style={{ flex: 1 }}
                placeholder="Enter Invite Token" 
                value={circleForm.invite_token} 
                onChange={e => setCircleForm({...circleForm, invite_token: e.target.value})} 
              />
              <button type="submit" className="btn-primary">Join</button>
            </form>
            <div style={{ display: 'flex', flexDirection: 'column' }}>
              {circles.map(c => (
                <div key={c.id} className="goal-item">
                  <span><strong>{c.circle_name}</strong> (ID: {c.id})</span>
                  <div style={{ display: 'flex', gap: '5px' }}>
                    <button onClick={() => fetchLeaderboard(c.id)} className="nav-btn" style={{ border: '1px solid var(--border)' }}>Rank</button>
                    <button onClick={() => generateInvite(c.id)} className="nav-btn" style={{ border: '1px solid var(--border)' }}>Invite</button>
                  </div>
                </div>
              ))}
              {circles.length === 0 && <p style={{ color: 'var(--text-muted)' }}>No circles joined yet.</p>}
            </div>
          </section>

          <section className="card">
            <h3>🏆 Circle Leaderboard</h3>
            {leaderboard.length > 0 ? (
              <table className="data-table">
                <thead>
                  <tr><th>User</th><th>Best Savings %</th></tr>
                </thead>
                <tbody>
                  {leaderboard.map((entry, i) => (
                    <tr key={i}>
                      <td>{entry.username}</td>
                      <td><strong>{entry.best_percentage?.toFixed(2)}%</strong></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : <p style={{ color: 'var(--text-muted)' }}>Select a circle to see rankings.</p>}
          </section>
        </div>
      )}
    </div>
  );
}

export default App;
