# Optional. The app calls /api by default, which works with the Vite dev proxy
# (vite.config.js) and on Vercel (vercel.json + api/).
#
# Only set this for a split deployment where the API is on another origin:
# VITE_API_URL=https://your-api.vercel.app
#
# In development, change the proxy target only if the backend is not on 3000:
# VITE_DEV_API_URL=http://localhost:3001
